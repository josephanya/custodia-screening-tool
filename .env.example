DATABASE_URL="postgresql://postgres:postgres@localhost:5433/custodia_screening_tool?schema=public"
NEXT_PUBLIC_NURSE_WHATSAPP_NUMBER=""

# Local development can use a plaintext password. Deployments should set
# NURSE_DASHBOARD_PASSWORD_HASH instead, generated with: npm run auth:hash -- "<password>"
NURSE_DASHBOARD_PASSWORD="change-this-password"
NURSE_DASHBOARD_PASSWORD_HASH=""

# Signs nothing on its own any more, but is the fallback secret for hashing audit identifiers.
NURSE_DASHBOARD_SESSION_SECRET="change-this-session-secret"

# Dedicated HMAC key for hashing IP addresses in nurse_sessions and audit_events.
AUDIT_HASH_SECRET="change-this-audit-hash-secret"

# Data retention, applied by: npm run db:retention
ASSESSMENT_RETENTION_DAYS="365"
AUDIT_RETENTION_DAYS="730"

# Recorded on seeded scoring rule versions so approvals are attributable.
SCORING_RULE_APPROVER=""
